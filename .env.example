# ==============================================================================
# Environment Configuration Template (Native Realtime Gemini Pipeline)
# Copy this file to .env (or Full-Duplex-Bench/v3/.env.local) and populate credentials.
# WARNING: NEVER commit .env or any file containing real API keys to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LiveKit Cloud Configuration (REQUIRED - Free tier: https://cloud.livekit.io)
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your_livekit_project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ------------------------------------------------------------------------------
# 2. Google Gemini Realtime Model Configuration (REQUIRED - Free tier: https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here

# Provider selection for lk_agent_tool.py: "gemini2_5" or "gemini3_1"
LK_PROVIDER=gemini2_5

# Optional voice name (defaults to "Puck", options include "Charon", "Kore", "Fenrir", "Aoede")
# GOOGLE_VOICE=Puck

# ------------------------------------------------------------------------------
# 3. Optional Paid Provider Keys (NOT needed for Gemini realtime agent)
# ------------------------------------------------------------------------------
# NOTE: The benchmark evaluation LLM judge (evaluate_tool_calls.py / evaluate_pass_rate.py)
# uses gpt-4o if --use-llm is passed. Without OPENAI_API_KEY, evaluation runs in
# exact-match string comparison mode (no paid key needed).
# OPENAI_API_KEY=your_openai_api_key_here

# Other optional realtime/STT/TTS plugins
# XAI_API_KEY=your_xai_api_key_here
# ULTRAVOX_API_KEY=your_ultravox_api_key_here
# DEEPGRAM_API_KEY=your_deepgram_api_key_here
# CARTESIA_API_KEY=your_cartesia_api_key_here
# ELEVEN_API_KEY=your_elevenlabs_api_key_here
