# ==============================================================================
# Environment Configuration Template (Native Realtime Gemini Pipeline)
# Copy this file to .env (or Full-Duplex-Bench/v3/.env.local) and populate credentials.
# WARNING: NEVER commit .env or any file containing real API keys to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LiveKit Cloud Configuration (REQUIRED - Free tier: https://cloud.livekit.io)
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your_livekit_project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ------------------------------------------------------------------------------
# 2. Google Gemini Realtime Model Configuration (REQUIRED)
#    Get a key at https://aistudio.google.com/ — Gemini Live needs a paid-tier
#    or sufficient quota; free-tier rate limits will stall a 100-scenario run.
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here

# Provider selection for lk_agent_tool.py: "gemini2_5" or "gemini3_1"
LK_PROVIDER=gemini2_5

# Optional voice name (defaults to "Puck", options include "Charon", "Kore", "Fenrir", "Aoede")
# GOOGLE_VOICE=Puck

# ------------------------------------------------------------------------------
# 3. FDB-v3 LLM judge (REQUIRED for organizer-matching scores)
#    The vendored benchmark (Full-Duplex-Bench/v3/evaluate_tool_calls.py and
#    evaluate_pass_rate.py) pins the judge to OpenAI model "gpt-4o" when
#    --use-llm is passed. reproduce.sh / reproduce.ps1 enable --use-llm by
#    default because that is what graders run. Opt out with --no-llm-judge.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# Other optional realtime/STT/TTS plugins (not used by the submitted Gemini agent)
# XAI_API_KEY=your_xai_api_key_here
# ULTRAVOX_API_KEY=your_ultravox_api_key_here
