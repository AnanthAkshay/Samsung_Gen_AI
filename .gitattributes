# Auto-detect text files
* text=auto

# Shell scripts must keep LF so Ubuntu / Git for Windows checkout is executable
*.sh text eol=lf
scripts/run_eval.sh text eol=lf
reproduce.sh text eol=lf

# PowerShell scripts use CRLF
*.ps1 text eol=crlf

# Keep Python sources as native checkout; patches are LF
*.py text
*.patch text eol=lf
